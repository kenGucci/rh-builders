# ============================================================
# GAMBO RH — Environment Variables
# Copy to .env.local and fill in your values
# ============================================================

# 1. X (Twitter) OAuth 2.0 — PKCE Flow
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback

# 2. Supabase — Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 3. JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret

# 4. Pexels API — Image search for Global page
PEXELS_API_KEY=your_pexels_api_key

# 5. Blockchain RPC — Robinhood Chain (Chain ID 4663)
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# 6. Financial Modeling Prep — Live Market Data
FMP_API_KEY=your_fmp_api_key

# 7. LunarCrush — Trending Crypto KOLs (optional)
LUNARCRUSH_API_KEY=

# 8. Bitquery — On-chain KOL Wallet Tracking (optional)
BITQUERY_API_KEY=

# 9. Alchemy — Multi-chain Wallet & Token Data (optional)
ALCHEMY_API_KEY=
