# ============================================================
# THE WALL RH — Environment Variables
# Copy to .env.local and fill in your values
# ============================================================

# 1. Supabase — Database (feedback, user-facing records)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 2. Blockchain RPC — Robinhood Chain (Chain ID 4663)
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# 3. Financial Modeling Prep — Live Market Data
FMP_API_KEY=your_fmp_api_key

# 4. Upstash Redis — Rate limiting (optional; app works without it)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
