# ============================================================
# THE WALL RH — Environment Variables
# Copy to .env.local and fill in your values
# ============================================================

# 1. Supabase — Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 2. JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret

# 3. Blockchain RPC — Robinhood Chain (Chain ID 4663)
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# 4. Financial Modeling Prep — Live Market Data
FMP_API_KEY=your_fmp_api_key

# 5. LunarCrush — Trending Crypto KOLs (optional)
LUNARCRUSH_API_KEY=

# 6. Bitquery — On-chain KOL Wallet Tracking (optional)
BITQUERY_API_KEY=

# 7. Alchemy — Multi-chain Wallet & Token Data (optional)
ALCHEMY_API_KEY=

# 8. Upstash Redis — Rate limiting (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 9. X (Twitter) OAuth 2.0 — "Continue with X" login
# Create an app at https://developer.x.com (Free tier works)
#   - User authentication settings: Read + Tweets, or Read
#   - App type: Native App (Web App also works)
#   - Redirect URI: https://rh-builders.vercel.app/api/auth/x/callback
#   - Enable PKCE (Recommended) with no client secret OR generate a client secret
# Client ID and Client Secret are shown on the "Keys and tokens" tab.
X_CLIENT_ID=
X_CLIENT_SECRET=

